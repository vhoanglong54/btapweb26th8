    <build><finalName>ServletCRUDMVC</finalName><plugins><plugin><artifactId>maven-war-plugin</artifactId><version>3.3.2</version></plugin><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.8.1</version></plugin></plugins></build>
