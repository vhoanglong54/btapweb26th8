<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Kích hoạt tài khoản | Dragon Store</title><%@ include file="includes/style.jsp" %></head><body><div class="auth-page"><main class="auth-shell"><div class="auth-brand"><span class="brand-mark">DS</span><span>Dragon Store</span></div><section class="surface auth-card"><p class="eyebrow">Bước cuối cùng</p><h1>Kích hoạt tài khoản</h1><p>Nhập mã OTP gồm 6 chữ số đã gửi đến email đăng ký. Mã có hiệu lực trong 10 phút.</p><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if>
<form action="${pageContext.request.contextPath}/activate" method="post" data-validate novalidate><label class="field">Mã OTP<input name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus></label><button type="submit">Kích hoạt tài khoản</button></form><form class="form-actions" action="${pageContext.request.contextPath}/activate" method="post"><input type="hidden" name="action" value="resend"><button class="btn secondary" type="submit">Gửi lại OTP</button></form><div class="auth-links"><a href="${pageContext.request.contextPath}/login">← Quay lại đăng nhập</a></div></section></main></div></body></html>
