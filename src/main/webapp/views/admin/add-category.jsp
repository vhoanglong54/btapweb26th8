<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html><head><title>Thêm danh mục | Dragon Store</title><%@ include file="../includes/style.jsp" %></head><body><%@ include file="../includes/header.jsp" %><main class="page-shell"><section class="surface admin-surface"><div class="page-heading"><div><p class="eyebrow">Quản trị danh mục</p><h1>Thêm danh mục</h1><p class="subtle">Tạo nhóm để phân loại sản phẩm trong cửa hàng.</p></div><a class="btn secondary" href="${pageContext.request.contextPath}/admin/categories">← Quay lại</a></div><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if><form action="${pageContext.request.contextPath}/admin/category/insert" method="post" enctype="multipart/form-data"><label class="field">Tên danh mục<input name="name" required autofocus></label><label class="field">Ảnh đại diện <span class="muted">(PNG, JPG, GIF hoặc WEBP)</span><input type="file" name="icon" accept="image/png,image/jpeg,image/gif,image/webp"></label><div class="form-actions"><button type="submit">Tạo danh mục</button><a class="btn secondary" href="${pageContext.request.contextPath}/admin/categories">Hủy</a></div></form></section></main></body></html>
