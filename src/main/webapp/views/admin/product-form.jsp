<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>${empty product ? 'Thêm' : 'Sửa'} sản phẩm | Dragon Store</title><%@ include file="../includes/style.jsp" %></head><body><%@ include file="../includes/header.jsp" %><main class="page-shell"><section class="surface admin-surface"><div class="page-heading"><div><p class="eyebrow">Quản trị sản phẩm</p><h1>${empty product ? 'Thêm sản phẩm' : 'Sửa sản phẩm'}</h1><p class="subtle">Những trường bắt buộc được kiểm tra trước khi lưu.</p></div><a class="btn secondary" href="${pageContext.request.contextPath}/admin/products">← Quay lại</a></div><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if>
<form action="${pageContext.request.contextPath}/admin/product/${empty product ? 'add' : 'edit'}" method="post" data-validate novalidate><c:if test="${not empty product}"><input type="hidden" name="id" value="${product.productId}"></c:if><div class="form-grid"><label class="field">Tên sản phẩm<input name="name" value="<c:out value='${product.name}'/>" maxlength="255" required autofocus></label><label class="field">Danh mục<select name="categoryId" required><option value="" disabled ${empty product ? 'selected' : ''}>Chọn danh mục</option><c:forEach items="${categories}" var="category"><option value="${category.categoryId}" ${product.category.categoryId == category.categoryId ? 'selected' : ''}><c:out value="${category.name}"/></option></c:forEach></select></label><label class="field">Giá<input type="number" name="price" min="0" step="0.01" max="9999999999999999.99" value="<c:out value='${product.price}'/>" required></label><label class="field">Trạng thái<select name="status" required><option value="1" ${empty product || product.status == 1 ? 'selected' : ''}>Hiển thị công khai</option><option value="0" ${product.status == 0 ? 'selected' : ''}>Ẩn khỏi cửa hàng</option></select></label><label class="field full">URL ảnh <span class="muted">(không bắt buộc)</span><input type="url" name="image" maxlength="2048" placeholder="https://example.com/image.jpg" value="<c:out value='${product.image}'/>"></label><label class="field full">Mô tả <span class="muted">(không bắt buộc, tối đa 2000 ký tự)</span><textarea name="description" rows="5" maxlength="2000" placeholder="Mô tả ngắn về sản phẩm"><c:out value="${product.description}"/></textarea></label></div><div class="form-actions"><button type="submit">Lưu sản phẩm</button><a class="btn secondary" href="${pageContext.request.contextPath}/admin/products">Hủy</a></div></form>
</section></main></body></html>
