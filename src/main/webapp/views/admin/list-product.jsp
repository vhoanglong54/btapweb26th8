<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><title>Quản lý sản phẩm | Dragon Store</title><%@ include file="../includes/style.jsp" %></head><body><%@ include file="../includes/header.jsp" %><main class="page-shell"><section class="surface admin-surface"><div class="page-heading"><div><p class="eyebrow">Quản trị</p><h1>Sản phẩm</h1><p class="subtle">Tạo, chỉnh sửa trạng thái và xóa sản phẩm trong cửa hàng.</p></div><a class="btn" href="${pageContext.request.contextPath}/admin/product/add">+ Thêm sản phẩm</a></div><div class="table-wrap"><table><thead><tr><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${products}" var="product"><tr><td><strong><c:out value="${product.name}"/></strong></td><td><c:out value="${product.category.name}"/></td><td><strong><c:out value="${product.price}"/> đ</strong></td><td><span class="badge ${product.status == 1 ? 'active' : 'hidden'}">${product.status == 1 ? 'Hiển thị' : 'Đang ẩn'}</span></td><td><div class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/admin/product/edit?id=${product.productId}">Sửa</a><form class="inline-form" action="${pageContext.request.contextPath}/admin/product/delete" method="post" onsubmit="return confirm('Xóa sản phẩm này?')"><input type="hidden" name="id" value="${product.productId}"><button class="btn danger" type="submit">Xóa</button></form></div></td></tr></c:forEach><c:if test="${empty products}"><tr><td colspan="5">Chưa có sản phẩm. Hãy thêm sản phẩm đầu tiên.</td></tr></c:if></tbody></table></div></section></main></body></html>
