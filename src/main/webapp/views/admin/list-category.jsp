<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Quản lý danh mục | Dragon Store</title><%@ include file="../includes/style.jsp" %></head><body><%@ include file="../includes/header.jsp" %><main class="page-shell"><section class="surface admin-surface"><div class="page-heading"><div><p class="eyebrow">Quản trị</p><h1>Danh mục</h1><p class="subtle">Tổ chức sản phẩm theo các nhóm dễ quản lý.</p></div><a class="btn" href="${pageContext.request.contextPath}/admin/category/add">+ Thêm danh mục</a></div><form class="search-form" action="${pageContext.request.contextPath}/admin/categories" method="get" data-validate novalidate><input name="keyword" value="<c:out value='${param.keyword}'/>" maxlength="100" autocomplete="off" placeholder="Tìm theo tên danh mục"><button class="btn secondary" type="submit">Tìm kiếm</button></form><div class="table-wrap"><table><thead><tr><th>STT</th><th>Ảnh đại diện</th><th>Tên danh mục</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${cateList}" var="cate" varStatus="st"><tr><td>${st.index + 1}</td><td><c:choose><c:when test="${not empty cate.icon}"><c:url value="/image" var="imgUrl"><c:param name="fname" value="${cate.icon}"/></c:url><img class="thumb" src="${imgUrl}" alt="<c:out value='${cate.name}'/>"></c:when><c:otherwise><span class="muted">Không có ảnh</span></c:otherwise></c:choose></td><td><strong><c:out value="${cate.name}"/></strong></td><td><div class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/admin/category/edit?id=${cate.id}">Sửa</a><form class="inline-form" action="${pageContext.request.contextPath}/admin/category/delete" method="post" onsubmit="return confirm('Xóa danh mục này và các sản phẩm liên quan?')"><input type="hidden" name="id" value="${cate.id}"><button class="btn danger" type="submit">Xóa</button></form></div></td></tr></c:forEach><c:if test="${empty cateList}"><tr><td colspan="4">Chưa có danh mục.</td></tr></c:if></tbody></table></div></section></main></body></html>
