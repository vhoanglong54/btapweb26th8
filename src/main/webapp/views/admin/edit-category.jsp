<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Sửa danh mục | Dragon Store</title><%@ include file="../includes/style.jsp" %></head><body><%@ include file="../includes/header.jsp" %><main class="page-shell"><section class="surface admin-surface"><div class="page-heading"><div><p class="eyebrow">Quản trị danh mục</p><h1>Sửa danh mục</h1><p class="subtle">Cập nhật tên hoặc thay ảnh đại diện của danh mục.</p></div><a class="btn secondary" href="${pageContext.request.contextPath}/admin/categories">← Quay lại</a></div><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if><form action="${pageContext.request.contextPath}/admin/category/update" method="post" enctype="multipart/form-data" data-validate novalidate><input type="hidden" name="id" value="${category.id}"><label class="field">Tên danh mục<input name="name" value="<c:out value='${category.name}'/>" maxlength="100" required autofocus></label><c:if test="${not empty category.icon}"><div class="current-image"><span class="muted">Ảnh hiện tại</span><c:url value="/image" var="imgUrl"><c:param name="fname" value="${category.icon}"/></c:url><p><img class="thumb" src="${imgUrl}" alt="Ảnh hiện tại"></p></div></c:if><label class="field">Ảnh đại diện mới <span class="muted">(để trống nếu giữ ảnh cũ; tối đa 5 MB)</span><input type="file" name="icon" accept="image/png,image/jpeg,image/gif,image/webp" data-image-upload></label><div class="form-actions"><button type="submit">Lưu thay đổi</button><a class="btn secondary" href="${pageContext.request.contextPath}/admin/categories">Hủy</a></div></form></section></main></body></html>
