<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><title>Quên mật khẩu | Dragon Store</title><%@ include file="includes/style.jsp" %></head><body><div class="auth-page"><main class="auth-shell"><div class="auth-brand"><span class="brand-mark">DS</span><span>Dragon Store</span></div><section class="surface auth-card"><p class="eyebrow">Khôi phục truy cập</p><h1>Quên mật khẩu?</h1><p>Nhập email đăng ký để nhận mã OTP đặt lại mật khẩu.</p><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if><form action="${pageContext.request.contextPath}/forgot-password" method="post" data-validate novalidate><label class="field">Email<input type="email" name="email" autocomplete="email" maxlength="254" required autofocus></label><button type="submit">Gửi mã OTP</button></form><div class="auth-links"><a href="${pageContext.request.contextPath}/login">← Quay lại đăng nhập</a></div></section></main></div></body></html>
