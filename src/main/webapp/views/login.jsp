<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Đăng nhập</title><%@ include file="includes/style.jsp" %></head><body><main class="card auth"><h1>Đăng nhập</h1><c:if test="${param.registered == '1'}"><p class="success">Đăng ký thành công. Hãy đăng nhập để tiếp tục.</p></c:if><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if><form action="${pageContext.request.contextPath}/login" method="post"><label class="field">Tài khoản<input name="username" required></label><label class="field">Mật khẩu<input type="password" name="password" required></label><label><input type="checkbox" name="remember"> Ghi nhớ đăng nhập (30 phút)</label><p><button type="submit">Đăng nhập</button></p></form><p>Chưa có tài khoản? <a href="${pageContext.request.contextPath}/register">Đăng ký</a></p><p><small>Tài khoản mẫu: <b>vuhoanglong</b> / <b>vuhoanglong</b></small></p></main></body></html>
